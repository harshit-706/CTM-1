# Environment variables for CTM-1 Prototype

# Simulator
SIMULATOR_TICK_RATE_HZ=10

# Edge Core
EDGE_HTTP_PORT=8080
EDGE_WS_PORT=8080
SQLITE_DB_PATH=ctm1.db

# Web App
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/live

# Astra / xAI / GPT AI Model Integration
ASTRA_GPT_API_KEY=your_xpl_api_key_here
ASTRA_MODEL_ENDPOINT=https://api.x.ai/v1/chat/completions
ASTRA_DEFAULT_MODEL=grok-beta

